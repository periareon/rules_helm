load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load(
    "//helm:defs.bzl",
    "helm_chart",
    "helm_lint_test",
    "helm_push",
    "helm_template",
    "helm_template_test",
)

helm_chart(
    name = "simple",
    registry_url = "oci://localhost/helm-registry",
)

# Smoke-test for the `registry_url_file` attribute. Ensures the rule analyzes
# and builds correctly when a file is used instead of a literal URL.
write_file(
    name = "simple_registry_url_file",
    out = "simple_registry_url.txt",
    content = [
        "oci://localhost/helm-registry",
        "",
    ],
)

helm_push(
    name = "simple.push_from_file",
    package = ":simple",
    registry_url_file = ":simple_registry_url_file",
)

helm_lint_test(
    name = "simple_lint_test",
    chart = ":simple",
)

helm_template(
    name = "simple_template",
    out = "simple.yaml",
    chart = ":simple",
)

helm_template_test(
    name = "simple_template_test",
    chart = ":simple",
)

# Baseline regression test: locks the OCI manifest digest computed from this
# chart to a known-good value.
diff_test(
    name = "simple_oci_digest_test",
    file1 = "simple.oci_digest.golden",
    file2 = ":simple.oci_digest",
)

filegroup(
    name = "simple_oci_manifest",
    srcs = [":simple.oci_digest"],
    output_group = "manifest",
)

filegroup(
    name = "simple_oci_config",
    srcs = [":simple.oci_digest"],
    output_group = "config",
)

# The digest above is the sha256 of this manifest, so locking both keeps them
# honest: changing one without the other fails here.
diff_test(
    name = "simple_oci_manifest_test",
    file1 = "simple.oci_manifest.golden",
    file2 = ":simple_oci_manifest",
)

diff_test(
    name = "simple_oci_config_test",
    file1 = "simple.oci_config.golden",
    file2 = ":simple_oci_config",
)
