load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load(
    "//helm:defs.bzl",
    "helm_chart",
    "helm_lint_test",
    "helm_oci_digest",
    "helm_push",
    "helm_template",
    "helm_template_test",
)

helm_chart(
    name = "simple",
    registry_url = "oci://localhost/helm-registry",
)

# Smoke-test for the `registry_url_file` attribute. Ensures the rule analyzes
# and builds correctly when a file is used instead of a literal URL.
write_file(
    name = "simple_registry_url_file",
    out = "simple_registry_url.txt",
    content = [
        "oci://localhost/helm-registry",
        "",
    ],
)

helm_push(
    name = "simple.push_from_file",
    package = ":simple",
    registry_url_file = ":simple_registry_url_file",
)

helm_lint_test(
    name = "simple_lint_test",
    chart = ":simple",
)

helm_template(
    name = "simple_template",
    out = "simple.yaml",
    chart = ":simple",
)

helm_template_test(
    name = "simple_template_test",
    chart = ":simple",
)

# Baseline regression test: locks the OCI manifest digest computed from this
# chart to a known-good value.
diff_test(
    name = "simple_oci_digest_test",
    file1 = "simple.oci_digest.golden",
    file2 = ":simple.oci_digest",
)

filegroup(
    name = "simple_oci_manifest",
    srcs = [":simple.oci_digest"],
    output_group = "manifest",
)

filegroup(
    name = "simple_oci_config",
    srcs = [":simple.oci_digest"],
    output_group = "config",
)

# The digest above is the sha256 of this manifest, so locking both keeps them
# honest: changing one without the other fails here.
diff_test(
    name = "simple_oci_manifest_test",
    file1 = "simple.oci_manifest.golden",
    file2 = ":simple_oci_manifest",
)

diff_test(
    name = "simple_oci_config_test",
    file1 = "simple.oci_config.golden",
    file2 = ":simple_oci_config",
)

# Lock the annotations, tag and repository that a pusher building its own
# manifest reads. `helm_chart`'s own `.oci_digest` has no registry URL, so the
# repository comes from a second target.
helm_oci_digest(
    name = "simple.oci_digest_with_url",
    chart = ":simple",
    registry_url = "oci://localhost/helm-registry/",
)

filegroup(
    name = "simple_oci_annotations",
    srcs = [":simple.oci_digest"],
    output_group = "annotations",
)

filegroup(
    name = "simple_oci_tag",
    srcs = [":simple.oci_digest"],
    output_group = "tag",
)

filegroup(
    name = "simple_oci_repository",
    srcs = [":simple.oci_digest_with_url"],
    output_group = "repository",
)

diff_test(
    name = "simple_oci_annotations_test",
    file1 = "simple.oci_annotations.golden",
    file2 = ":simple_oci_annotations",
)

diff_test(
    name = "simple_oci_tag_test",
    file1 = "simple.oci_tag.golden",
    file2 = ":simple_oci_tag",
)

diff_test(
    name = "simple_oci_repository_test",
    file1 = "simple.oci_repository.golden",
    file2 = ":simple_oci_repository",
)
