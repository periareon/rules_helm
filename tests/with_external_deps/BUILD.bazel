load("@rules_go//go:def.bzl", "go_test")
load("//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")

exports_files(["Chart.lock"])

helm_chart(
    name = "with_external_deps",
    deps = [
        "@helm_test_deps__with_external_deps_bank_vaults//:vault-operator",
        "@helm_test_deps__with_external_deps_cert_manager//:cert-manager",
        "@helm_test_deps__with_external_deps_grafana//:grafana",
        "@helm_test_deps__with_external_deps_karpenter//:karpenter",
        "@helm_test_deps__with_external_deps_postgresql//:postgresql",
        "@helm_test_deps__with_external_deps_redis//:redis",
        "@helm_test_deps__with_external_deps_trust_manager//:trust-manager",
    ],
)

helm_lint_test(
    name = "with_external_deps_lint_test",
    chart = ":with_external_deps",
)

helm_template_test(
    name = "with_external_deps_template_test",
    chart = ":with_external_deps",
    opts = ["--set=karpenter.settings.clusterName=test"],
)

# The `package_metadata` generated by `helm_import_repository` for each chart.
filegroup(
    name = "package_metadata",
    srcs = [
        "@helm_test_deps__with_external_deps_bank_vaults//:package_metadata",
        "@helm_test_deps__with_external_deps_cert_manager//:package_metadata",
        "@helm_test_deps__with_external_deps_grafana//:package_metadata",
        "@helm_test_deps__with_external_deps_karpenter//:package_metadata",
        "@helm_test_deps__with_external_deps_postgresql//:package_metadata",
        "@helm_test_deps__with_external_deps_redis//:package_metadata",
        "@helm_test_deps__with_external_deps_trust_manager//:package_metadata",
        "@helm_test_deps__with_external_deps_vault//:package_metadata",
    ],
)

# The `license` generated for each chart.
filegroup(
    name = "licenses",
    srcs = [
        "@helm_test_deps__with_external_deps_bank_vaults//:license",
        "@helm_test_deps__with_external_deps_cert_manager//:license",
        "@helm_test_deps__with_external_deps_grafana//:license",
        "@helm_test_deps__with_external_deps_karpenter//:license",
        "@helm_test_deps__with_external_deps_postgresql//:license",
        "@helm_test_deps__with_external_deps_redis//:license",
        "@helm_test_deps__with_external_deps_trust_manager//:license",
        "@helm_test_deps__with_external_deps_vault//:license",
    ],
)

go_test(
    name = "with_external_deps_test",
    srcs = [
        "package_metadata_test.go",
        "with_external_deps_test.go",
    ],
    data = [
        ":licenses",
        ":package_metadata",
        ":with_external_deps",
    ],
    env = {
        "HELM_CHART": "$(rlocationpath :with_external_deps)",
        "LICENSES": "$(rlocationpaths :licenses)",
        "PACKAGE_METADATA": "$(rlocationpaths :package_metadata)",
    },
    deps = [
        "@in_gopkg_yaml_v3//:yaml_v3",
        "@rules_go//go/runfiles",
    ],
)
