load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_helm//tests:test_defs.bzl", "helm_package_regex_test")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("//:defs.bzl", "helm_chart", "helm_lint_test", "helm_oci_image", "helm_template_test", "oci_push")

exports_files(["Chart.lock"])

EXCLUDE_WINDOWS = select({
    # TODO: rules_oci is broken on simple windows systems such as the windows github runners
    # https://github.com/periareon/rules_helm/issues/53
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

helm_chart(
    name = "with_image_deps",
    images = [
        ":image_a.push",
        ":image_b.push",
        ":image_c.push",
    ],
    target_compatible_with = EXCLUDE_WINDOWS,
)

helm_lint_test(
    name = "with_image_deps_lint_test",
    chart = ":with_image_deps",
    target_compatible_with = EXCLUDE_WINDOWS,
)

helm_template_test(
    name = "with_image_deps_template_test",
    chart = ":with_image_deps",
    target_compatible_with = EXCLUDE_WINDOWS,
)

helm_package_regex_test(
    name = "with_image_deps_regex_test",
    package = ":with_image_deps",
    target_compatible_with = EXCLUDE_WINDOWS,
    values_patterns = [
        r"image_a:\s+url:\s+\"docker.io/rules_helm/test/image_a@sha256:[a-z0-9]{64}\"",
        r"image_b:\s+url:\s+\"docker.io/rules_helm/test/image_b@sha256:[a-z0-9]{64}\"",
        r"image_c:\s+url:\s+\"docker.io/rules_helm/test/image_c:1.2.3\"",
    ],
)

_IMAGES = [
    "image_a",
    "image_b",
    "image_c",
]

# Built without a base image: `oci_pull` under bzlmod needs a patched
# `rules_oci` (https://github.com/bazel-contrib/rules_oci/pull/891), and
# these images only need to exist to be pushed.
[
    oci_image(
        name = name,
        architecture = "amd64",
        os = "linux",
        target_compatible_with = EXCLUDE_WINDOWS,
    )
    for name in _IMAGES
]

oci_push(
    name = "image_a.push",
    image = ":image_a",
    remote_tags = ["latest"],
    repository = "docker.io/rules_helm/test/image_a",
    target_compatible_with = EXCLUDE_WINDOWS,
)

write_file(
    name = "image_b.repository",
    out = "image_b.repository.txt",
    content = ["docker.io/rules_helm/test/image_b"],
    tags = ["manual"],
)

oci_push(
    name = "image_b.push",
    image = ":image_b",
    remote_tags = ["latest"],
    repository_file = ":image_b.repository.txt",
    target_compatible_with = EXCLUDE_WINDOWS,
)

oci_push(
    name = "image_c.push",
    image = ":image_c",
    remote_tags = ["1.2.3"],
    repository = "docker.io/rules_helm/test/image_c",
    target_compatible_with = EXCLUDE_WINDOWS,
)

# The same chart with its images described by `helm_oci_image` instead of
# relying on the aspect in `rules_helm`.
[
    helm_oci_image(
        name = "{}.helm".format(name),
        image = ":{}.push".format(name),
        target_compatible_with = EXCLUDE_WINDOWS,
    )
    for name in _IMAGES
]

helm_chart(
    name = "with_image_deps_adapted",
    images = ["{}.helm".format(name) for name in _IMAGES],
    target_compatible_with = EXCLUDE_WINDOWS,
)

helm_package_regex_test(
    name = "with_image_deps_adapted_regex_test",
    package = ":with_image_deps_adapted",
    target_compatible_with = EXCLUDE_WINDOWS,
    values_patterns = [
        r"image_a:\s+url:\s+\"docker.io/rules_helm/test/image_a@sha256:[a-z0-9]{64}\"",
        r"image_b:\s+url:\s+\"docker.io/rules_helm/test/image_b@sha256:[a-z0-9]{64}\"",
        r"image_c:\s+url:\s+\"docker.io/rules_helm/test/image_c:1.2.3\"",
    ],
)
