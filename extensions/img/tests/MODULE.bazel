"""periareon/rules_helm/extensions/img/tests

The tests for `rules_helm_img`, as a module of their own. `../.bazelignore`
keeps them out of `@rules_helm_img//...`, because they need dependencies that
a module depending on `rules_helm_img` cannot see. It is not released as a
module, but it ships in the source archive, where the BCR presubmit runs it.
"""

module(name = "rules_helm_img_tests")

# `..` exists in a checkout and in the release archive after `strip_prefix`, so
# this override can live here.
bazel_dep(name = "rules_helm_img")
local_path_override(
    module_name = "rules_helm_img",
    path = "..",
)

# `.bazelrc` resolves this to the checkout, because `../../..` exists only
# there. In the extracted release archive the registry supplies it, so it
# must be a released version. It is a lower bound: the resolution raises it
# to the version `rules_helm_img` requires. Bump it in the release PR with
# the other version strings.
bazel_dep(name = "rules_helm", version = "0.38.0")

# Keep these in line with `../MODULE.bazel`.
bazel_dep(name = "rules_img", version = "0.3.24")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# For the Go test in `helm_oci_manifest`. The Go SDK itself comes from
# `rules_helm`, which already needs one for its tools.
bazel_dep(name = "rules_go", version = "0.63.0")

# An image pulled with `img_pull`, for the `image_import` cases in
# `with_image_deps`.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "rules_helm_test_img_container_base",
    digest = "sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659",
    registry = "index.docker.io",
    repository = "library/alpine",
    tag = "3.23.3",
)
