"""`HelmImageInfo` for images built with rules_img."""

load("@rules_helm//helm:defs.bzl", "HelmImageInfo")
load(
    "@rules_img//img:providers.bzl",
    "DeployInfo",
    "ImageIndexInfo",
    "ImageManifestInfo",
    "PullInfo",
)

def _strip_scheme(registry):
    return registry.replace("https://", "").replace("http://", "")

def _img_pull_aliases(label):
    """The public labels `img_pull` defines for its `image_import` target.

    Bazel resolves aliases before rules see them, so values written against an
    alias would otherwise never be stamped.
    """

    # `img_pull` writes its targets at the root of the repository it creates.
    if label.package or not label.repo_name:
        return []

    # The repository's apparent name, which `img_pull` also uses as an alias.
    repo = label.repo_name.split("~")[-1].split("+")[-1]

    # From rules_img 0.3.17 the target is `image_import`, and `image` and
    # `final` are aliases to it. Before that, the target itself was `image`.
    if label.name == "image_import":
        names = ["image", "final", repo]
    elif label.name == "image":
        names = [repo]
    else:
        return []
    return [label.same_package_label(name) for name in names]

def _manifest_of(image):
    """The raw manifest or index file of an `ImageManifestInfo` or `ImageIndexInfo`."""
    if hasattr(image, "index"):
        return image.index
    return image.manifest

def _extract(ctx, input, output, template):
    """Render a Go template against a json file."""
    args = ctx.actions.args()
    args.add("-input", input)
    args.add("-output", output)
    args.add("-template", template)

    ctx.actions.run(
        executable = ctx.executable._json_extractor,
        mnemonic = "HelmImgDeployManifest",
        arguments = [args],
        inputs = [input],
        outputs = [output],
    )

def _from_deploy_info(ctx, target):
    """Describe an `image_push` target.

    The push destination lives in `DeployInfo.deploy_manifest`, where any
    `{{ .registry }}` style templates have already been expanded, and the bytes
    that get pushed are the manifest of `DeployInfo.image`.
    """
    info = target[DeployInfo]

    repository = ctx.actions.declare_file("{}.repository.txt".format(ctx.label.name))
    _extract(ctx, info.deploy_manifest, repository, """
    {{- with index .operations 0 -}}
        {{- $registry := .registry -}}
        {{- $registry = trimPrefix $registry "https://" -}}
        {{- $registry = trimPrefix $registry "http://" -}}

        {{- $registry }}/{{ .repository -}}
    {{- end -}}
    """)

    tags = ctx.actions.declare_file("{}.tags.txt".format(ctx.label.name))
    _extract(ctx, info.deploy_manifest, tags, """
    {{- with index .operations 0 -}}
        {{- range $tag := .tags -}}
            {{- $tag | println -}}
        {{- end -}}
    {{- end -}}
    """)

    return HelmImageInfo(
        label = target.label,
        aliases = [],
        repository = repository,
        manifest = _manifest_of(info.image),
        tags = tags,
        pusher = target[DefaultInfo].files_to_run.executable,
        runfiles = target[DefaultInfo].default_runfiles,
    )

def _from_pull_info(ctx, target):
    """Describe an `image_import` target generated by `img_pull`.

    Everything is known at analysis time. `registries` lists the primary
    registry first, followed by any mirrors.
    """
    info = target[PullInfo]

    if not info.registries:
        fail("{} does not record the registry it was pulled from".format(target.label))

    repository = ctx.actions.declare_file("{}.repository.txt".format(ctx.label.name))
    ctx.actions.write(
        output = repository,
        content = "{}/{}".format(_strip_scheme(info.registries[0]), info.repository),
    )

    tags = None
    if info.tag:
        tags = ctx.actions.declare_file("{}.tags.txt".format(ctx.label.name))
        ctx.actions.write(
            output = tags,
            content = info.tag,
        )

    if ImageIndexInfo in target:
        manifest = target[ImageIndexInfo].index
    elif ImageManifestInfo in target:
        manifest = target[ImageManifestInfo].manifest
    else:
        fail("{} provides neither `ImageIndexInfo` nor `ImageManifestInfo`".format(target.label))

    return HelmImageInfo(
        label = target.label,
        aliases = _img_pull_aliases(target.label),
        repository = repository,
        manifest = manifest,
        tags = tags,
        # Pulled images are referenced by their source registry and never pushed.
        pusher = None,
        runfiles = ctx.runfiles(),
    )

def _helm_img_image_impl(ctx):
    target = ctx.attr.image
    if DeployInfo in target:
        info = _from_deploy_info(ctx, target)
    elif PullInfo in target:
        info = _from_pull_info(ctx, target)
    else:
        fail("{} must be an `image_push` or `image_import` target".format(target.label))

    return [
        DefaultInfo(files = depset([info.manifest])),
        info,
    ]

helm_img_image = rule(
    doc = """\
Describe a `rules_img` image to `rules_helm`.

Accepts an `image_push` target, or an `image_import` target as generated by
`img_pull`, and provides `HelmImageInfo` from their `DeployInfo` and `PullInfo`
providers. Values keep referring to the wrapped target, e.g.
`{@//app:image.push}`.
""",
    implementation = _helm_img_image_impl,
    attrs = {
        "image": attr.label(
            doc = "An `image_push` or `image_import` target.",
            mandatory = True,
            providers = [[DeployInfo], [PullInfo]],
        ),
        "_json_extractor": attr.label(
            doc = "Tool for extracting data from json files",
            cfg = "exec",
            executable = True,
            default = Label("@rules_helm//helm/private/json_extractor"),
        ),
    },
    provides = [HelmImageInfo],
)
