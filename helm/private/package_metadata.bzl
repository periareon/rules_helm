"""Re-exports of `@package_metadata` for the `BUILD.bazel` files generated by `rules_helm`."""

load(
    "@package_metadata//licenses:defs.bzl",
    _license = "license",
    _license_kind = "license_kind",
)
load("@package_metadata//rules:package_metadata.bzl", _package_metadata = "package_metadata")

license = _license
license_kind = _license_kind
package_metadata = _package_metadata
