"""Utilities for container images"""

load(":json_extractor.bzl", "json_extractor")
load(":providers.bzl", "HelmImageInfo")

def _strip_scheme(registry):
    return registry.replace("https://", "").replace("http://", "")

def _img_pull_aliases(label):
    """The public labels `img_pull` defines for its `image_import` target.

    Bazel resolves aliases before rules see them, so values written against an
    alias would otherwise never be stamped.
    """

    # `img_pull` writes its targets at the root of the repository it creates.
    if label.package or not label.repo_name:
        return []

    # The repository's apparent name, which `img_pull` also uses as an alias.
    repo = label.repo_name.split("~")[-1].split("+")[-1]

    # From rules_img 0.3.17 the target is `image_import`, and `image` and
    # `final` are aliases to it. Before that, the target itself was `image`.
    if label.name == "image_import":
        names = ["image", "final", repo]
    elif label.name == "image":
        names = [repo]
    else:
        return []
    return [label.same_package_label(name) for name in names]

def _image_import_info(target, ctx):
    """Describe an `image_import` target generated by `img_pull`."""

    # `image_import` exposes the pulled root manifest (or index) blob as its
    # only default output. Prefer it over re-writing the inline `data` attribute
    # so the digest is computed from the exact bytes that were pulled.
    manifest = None
    files = target[DefaultInfo].files.to_list()
    if len(files) == 1:
        manifest = files[0]
    else:
        digest = getattr(ctx.rule.attr, "digest", None)
        data = getattr(ctx.rule.attr, "data", None) or {}
        if not digest or digest not in data:
            fail("image_import target {} does not provide a root manifest".format(target.label))

        manifest = ctx.actions.declare_file("{}.rules_helm.manifest.json".format(target.label.name))
        ctx.actions.write(
            output = manifest,
            content = data[digest],
        )

    # `img_pull` records every registry it may pull from in `registries`, in the
    # order they are tried: the primary `registry` first, followed by any
    # mirrors. Use the first entry so the chart references the primary
    # registry. Older versions of rules_img expose a single `registry` instead.
    registry = None
    registries = getattr(ctx.rule.attr, "registries", None)
    if registries:
        registry = registries[0]
    elif getattr(ctx.rule.attr, "registry", None):
        registry = ctx.rule.attr.registry

    if not registry:
        fail("image_import target {} must have either a `registry` or `registries` attribute".format(target.label))

    repository = getattr(ctx.rule.attr, "repository", None)
    if not repository:
        fail("image_import target {} must have a `repository` attribute".format(target.label))

    repository_file = ctx.actions.declare_file("{}.rules_helm.repository.txt".format(target.label.name))
    ctx.actions.write(
        output = repository_file,
        content = "{}/{}".format(_strip_scheme(registry), repository),
    )

    tags = None
    tag = getattr(ctx.rule.attr, "tag", None)
    if tag:
        tags = ctx.actions.declare_file("{}.rules_helm.tags.txt".format(target.label.name))
        ctx.actions.write(
            output = tags,
            content = tag,
        )

    return HelmImageInfo(
        label = target.label,
        aliases = _img_pull_aliases(target.label),
        repository = repository_file,
        manifest = manifest,
        tags = tags,
        # Pulled images are referenced by their source registry and never pushed.
        pusher = None,
        runfiles = ctx.runfiles(),
    )

def _image_push_info(target, ctx):
    """Describe an `image_push` target from rules_img."""
    repository_file = None
    tags = None
    manifest = None

    if not hasattr(ctx.rule.attr, "image") or not ctx.rule.attr.image:
        fail("image_push target {} must have an `image` attribute".format(target.label))

    # Get the image file from the image attribute
    if hasattr(ctx.rule.files, "image") and ctx.rule.files.image:
        manifest = ctx.rule.files.image[0]
    elif hasattr(ctx.rule.file, "image") and ctx.rule.file.image:
        manifest = ctx.rule.file.image
    else:
        fail("image_push target {} `image` attribute must provide files".format(target.label))

    # First we try and use the push metadata file generated by the rule, which
    # is preferred because it contains expanded templates
    metadata_file = None

    info = target[DefaultInfo]
    files = []

    # Versions < 0.3.0 have the metadata in files
    if hasattr(info, "files") and info.files:
        files = files + info.files.to_list()

    # Versions >= 0.3.0 have it in the runfiles
    if hasattr(info, "default_runfiles") and info.default_runfiles:
        runfiles = info.default_runfiles
        if hasattr(runfiles, "files") and runfiles.files:
            files += files + runfiles.files.to_list()

    for file in files:
        if file.basename == "{}.json".format(ctx.label.name):
            metadata_file = file
            break

    if metadata_file:
        repository_template = """
        {{- with index .operations 0 -}}
            {{- $registry := .registry -}}
            {{- $registry = trimPrefix $registry "https://" -}}
            {{- $registry = trimPrefix $registry "http://" -}}

            {{- $registry }}/{{ .repository -}}
        {{- end -}}
        """

        repository_file = ctx.actions.declare_file("{}.rules_helm.repository.txt".format(target.label.name))
        json_extractor(ctx, metadata_file, repository_file, repository_template)

        tags_template = """
        {{- with index .operations 0 -}}
            {{- range $tag := .tags -}}
                {{- $tag | println -}}
            {{- end -}}
        {{- end -}}
        """

        tags = ctx.actions.declare_file("{}.rules_helm.tags.txt".format(target.label.name))
        json_extractor(ctx, metadata_file, tags, tags_template)

    # Next alternative, try and use attrs from the rule itself
    if repository_file == None:
        if not hasattr(ctx.rule.attr, "registry") or not ctx.rule.attr.registy:
            fail("image_push target {} must have a `registry` attribute".format(target.label))

        registry = ctx.rule.attr.registry

        if not hasattr(ctx.rule.attr, "repository") or not ctx.rule.attr.repository:
            fail("image_push target {} must have a `repository` attribute".format(target.label))

        repository = ctx.rule.attr.repository

        repository_file = ctx.actions.declare_file("{}.rules_helm.repository.txt".format(target.label.name))
        ctx.actions.write(
            output = repository_file,
            content = "{}/{}".format(_strip_scheme(registry), repository),
        )

    if tags == None:
        tag_list = None

        if hasattr(ctx.rule.attr, "tag") and ctx.rule.attr.tag:
            tag_list = [ctx.rule.attr.tag]
        elif hasattr(ctx.rule.attr, "tag_list") and ctx.rule.attr.tag_list:
            tag_list = ctx.rule.attr.tag_list

        # If either tag or tag_list was set, we produce a tag list file
        # ourselves
        if tag_list != None:
            tags = ctx.actions.declare_file("{}.rules_helm.tags.txt".format(target.label.name))
            ctx.actions.write(
                output = tags,
                content = "\n".join(tag_list),
            )
        elif hasattr(ctx.rule.file, "tag_file") and ctx.rule.file.tag_file:
            # Tags can also be provided as a file, in which case we can re-use
            # it
            tags = ctx.rule.file.tag_file

    return HelmImageInfo(
        label = target.label,
        aliases = [],
        repository = repository_file,
        manifest = manifest,
        tags = tags,
        pusher = info.files_to_run.executable,
        runfiles = info.default_runfiles,
    )

def _oci_push_info(target, ctx):
    """Describe an `oci_push` target from rules_oci."""
    repository_file = None
    tags = None

    # The repository can either be provided as a string attr, or as a file
    if hasattr(ctx.rule.attr, "repository") and ctx.rule.attr.repository:
        repository_file = ctx.actions.declare_file("{}.rules_helm.repository.txt".format(target.label.name))
        ctx.actions.write(
            output = repository_file,
            content = ctx.rule.attr.repository,
        )
    elif hasattr(ctx.rule.file, "repository_file") and ctx.rule.file.repository_file:
        repository_file = ctx.rule.file.repository_file

    if repository_file == None:
        fail("oci_push target {} must have either a `repository` or `repository_file` attribute".format(target.label.name))

    if hasattr(ctx.rule.file, "remote_tags") and ctx.rule.file.remote_tags:
        tags = ctx.rule.file.remote_tags

    if not hasattr(ctx.rule.file, "image") or not ctx.rule.file.image:
        fail("oci_push target {} must have an `image` attribute".format(target.label))

    # `oci_push` points at an OCI image layout. Lift the root manifest out of
    # it so the image is described the same way as every other provider.
    manifest = ctx.actions.declare_file("{}.rules_helm.manifest.json".format(target.label.name))
    layout_manifest(ctx, ctx.rule.file.image, manifest)

    info = target[DefaultInfo]
    return HelmImageInfo(
        label = target.label,
        aliases = [],
        repository = repository_file,
        manifest = manifest,
        tags = tags,
        pusher = info.files_to_run.executable,
        runfiles = info.default_runfiles,
    )

def layout_manifest(ctx, layout, output):
    """Copy the root manifest out of an OCI image layout.

    Args:
        ctx: The rule or aspect context. Requires a `_layout_manifest` executable attribute.
        layout: File: The OCI image layout directory.
        output: File: Where to write the manifest.
    """
    args = ctx.actions.args()
    args.add("-layout", layout.path)
    args.add("-output", output)

    ctx.actions.run(
        executable = ctx.executable._layout_manifest,
        mnemonic = "HelmOciLayoutManifest",
        arguments = [args],
        inputs = [layout],
        outputs = [output],
    )

def _helm_image_aspect_impl(target, ctx):
    # Targets that already describe themselves need nothing from us.
    if HelmImageInfo in target:
        return []

    if ctx.rule.kind == "image_import":
        return [_image_import_info(target, ctx)]

    if ctx.rule.kind == "image_push" or hasattr(ctx.rule.attr, "registry"):
        return [_image_push_info(target, ctx)]

    return [_oci_push_info(target, ctx)]

# This aspect exists because rules_oci and rules_img don't provide a provider
# that cleanly publishes this information but for the helm rules, it's
# absolutely necessary that an image's repository and digest are knowable.
# It recognises the push and pull rules by shape and reads their attributes.
# The companion modules (`rules_helm_img`, `rules_helm_oci`) provide
# `HelmImageInfo` from the image rules' own providers instead, and this aspect
# steps aside for any target that already carries it.
helm_image_aspect = aspect(
    doc = "Provides `HelmImageInfo` for a given oci_push, image_push or image_import target",
    implementation = _helm_image_aspect_impl,
    attrs = {
        "_json_extractor": attr.label(
            doc = "Tool for extracting data from json files",
            cfg = "exec",
            executable = True,
            default = Label("//helm/private/json_extractor"),
        ),
        "_layout_manifest": attr.label(
            doc = "Tool for copying the root manifest out of an OCI image layout",
            cfg = "exec",
            executable = True,
            default = Label("//helm/private/layout_manifest"),
        ),
    },
)

def _helm_image_impl(ctx):
    pusher = None
    runfiles = ctx.runfiles()
    if ctx.attr.pusher:
        pusher = ctx.attr.pusher[DefaultInfo].files_to_run.executable
        runfiles = ctx.attr.pusher[DefaultInfo].default_runfiles

    return [
        DefaultInfo(files = depset([ctx.file.manifest])),
        HelmImageInfo(
            label = ctx.label,
            aliases = [],
            repository = ctx.file.repository,
            manifest = ctx.file.manifest,
            tags = ctx.file.remote_tags,
            pusher = pusher,
            runfiles = runfiles,
        ),
    ]

helm_image = rule(
    doc = """\
Describe a container image to `rules_helm` from plain files.

This is the reference implementation of `HelmImageInfo`, for images that are
built or pushed by something `rules_helm` does not know about. Values refer to
it by this target's label, e.g. `{@//app:image}`.
""",
    implementation = _helm_image_impl,
    attrs = {
        "manifest": attr.label(
            doc = "The raw OCI manifest or index exactly as it is pushed. Its sha256 is the digest stamped into the chart.",
            allow_single_file = True,
            mandatory = True,
        ),
        "pusher": attr.label(
            doc = "An executable that pushes the image. Run before the chart is installed or pushed. Leave unset for images that are only referenced.",
            executable = True,
            cfg = "target",
        ),
        "remote_tags": attr.label(
            doc = "A file containing the remote tags, one per line. With exactly one tag, values may stamp `{@label.tag}`.",
            allow_single_file = True,
        ),
        "repository": attr.label(
            doc = "A file containing `<registry>/<repository>` on a single line, with no scheme.",
            allow_single_file = True,
            mandatory = True,
        ),
    },
    provides = [HelmImageInfo],
)
