load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "oci_parts_lib",
    srcs = ["oci_parts.go"],
    importpath = "github.com/periareon/rules_helm/helm/private/oci_parts",
    visibility = ["//visibility:private"],
    deps = ["//helm/private/oci_digest/ociartifact"],
)

# `@rules_helm_img` runs this binary (`extensions/img/private/oci_manifest.bzl`).
# MVS can pair a released `rules_helm_img` with a newer `rules_helm`, so flags
# may be added but not renamed or removed.
go_binary(
    name = "oci_parts",
    embed = [":oci_parts_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "oci_parts_test",
    srcs = ["oci_parts_test.go"],
    embed = [":oci_parts_lib"],
)
