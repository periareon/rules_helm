load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

filegroup(
    name = "bzl_srcs",
    srcs = glob(["**/*.bzl"]),
    visibility = ["//:__subpackages__"],
)

bzl_library(
    name = "bzl_lib",
    srcs = ["bzl_srcs"],
    visibility = ["//k8s:__subpackages__"],
    deps = [
        "//helm/private:bzl_lib",
    ],
)
