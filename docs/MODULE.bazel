"""periareon/rules_helm/docs

The book is its own Bazel module so it can document `rules_helm` and the
image modules under `extensions/` together. Dependencies only ever point
from here, and from the extensions, toward `rules_helm`; nothing depends
on this module and it is never published.
"""

module(name = "rules_helm_docs")

# The modules released from this repository, resolved to this checkout. The
# overrides can live here rather than in `.bazelrc` as the extensions do,
# because this module is never published.
bazel_dep(name = "rules_helm")
local_path_override(
    module_name = "rules_helm",
    path = "..",
)

bazel_dep(name = "rules_helm_img")
local_path_override(
    module_name = "rules_helm_img",
    path = "../extensions/img",
)

bazel_dep(name = "rules_helm_oci")
local_path_override(
    module_name = "rules_helm_oci",
    path = "../extensions/oci",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_rust_mdbook", version = "0.69.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "stardoc", version = "0.8.1")
